<!DOCTYPE html>
<html>
<head>
    <title>Reset Password - Step 1</title>
    <link rel="stylesheet" href="/css/showoof.css">
</head>
<body style="background-color: #FEFAE0;">
    <main>
        <div id="form-box" style="background-color: #FAEDCD; padding: 20px; max-width: 400px; margin: 50px auto; border-radius: 10px;">
            <h2>Reset Password</h2>
            <p>Enter your account email to proceed.</p>
            <form action="/reset_password" method="POST">
                <input type="email" name="email" placeholder="Email" required style="width: 100%; padding: 10px; margin-bottom: 15px; background: white;">
                <% if (error && error.length > 0) { %>
                    <p style="color: red;"><%= error %></p>
                <% } %>
                <button type="submit" style="background-color: #D4A373; color: white; padding: 10px; border: none; cursor: pointer; width: 100%;">Next</button>
            </form>
        </div>
    </main>
</body>
</html>
