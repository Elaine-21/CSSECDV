<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Account Banned</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #fff3f3;
      color: #d8000c;
      text-align: center;
      padding: 50px;
    }
    .container {
      border: 2px solid #d8000c;
      display: inline-block;
      padding: 40px;
      background-color: #ffe6e6;
      border-radius: 10px;
    }
    a {
      color: #d8000c;
      text-decoration: underline;
      display: block;
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>Your account has been banned</h1>
    <p>If you believe this is a mistake, please contact the site administrator.</p>
    <a href="/login" role="button">Proceed to login</a>
  </div>
</body>
</html>
