<!DOCTYPE html>

<head>
    <link rel="stylesheet" type="text/css" href="/css/format.css"/>
    <link rel="stylesheet" type="text/css" href="/css/profile_format.css"/>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/js/vote.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <title>u/<%=username%></title>
</head>

<body>
    <%- include('partials/sticky-no-search.ejs'); %>
    
    <%- include('partials/nav_panel.ejs'); %>

    <div id="profile-container">
        <div id="cover-photo" style="background-image: url(<%=bgPicPath%>);"></div>

        <div id="profile-name-content">
            <div id="profile-picture-container">
                <img src="<%=pPicPath%>">
            </div>

            <p>u/<%=username%></p>
            
            <% if (username === user) {%>
            <div class="edit-profile-btn">
                <a href="<%=user%>/edit">Edit Profile</a>
            </div>
            <% } else if(userType == "moderator" || userType == "admin") {%>
            <div class="settings-icon">
                <i class="bi bi-three-dots"></i>
                <div class="settings-popup" id="settingsPopup">
                    <!-- <a href="/ban/<%=username%>">Ban User</a>
                    <a href="/warn/<%=username%>">Mute User</a> -->
                    <a id="mute-user">Mute User</a>
                    <a id="ban-user">Ban User</a>
                </div>
            </div>
            <%} %>
        </div>

        <% if (username === user) {%>
        <p id="posts-header"><b>Your Posts</b></p>
        <% } else { %>
            <p id="posts-header"><b>u/<%= username %>'s Posts</b></p>
        <% } %>

        <div id="profile-content">
            <div id="user-posts">
                <% data.forEach(post => { %>
                    <div class="post-container">
                        <div class="vote-content">
                            <% let uvote = "upvote-not" %>
                            <% let dvote = "downvote-not"; %>

                            <% post.upvotes.forEach(user => { %>
                                <% if (user.equals(userID)) {%>
                                    <% uvote = "upvote" %>
                                <% } %>
                            <% }) %>
                            <% post.downvotes.forEach(user => { %>
                                <% if (user.equals(userID)) {%>
                                    <% dvote = "downvote" %>
                                <% } %>
                            <% }) %>

                            <button class="<%= uvote %>" id="upvoteID:<%=post._id%>"><img></button>
                            <p id="statusID<%=post._id%>"><%= post.upvotes.length - post.downvotes.length %></p>
                            <button class="<%= dvote %>" id="downvoteID:<%=post._id%>"><img></button>
                        </div>
        
                        <div class="post-content">
                            <PostMeta>
                                Posted by <a href="/profiles/<%=post.author%>">u/<%= post.author %></a>
                                <% if (post.postEdit) { %>
                                    Edited: 
                                <% } %>
                                <%= post.datePosted.toDateString() %>
                            </PostMeta>
                            <div class="colorA">
                                <a href="/posts/<%=post._id%>">
                                    <PostTitle><%= post.title %></PostTitle>
                                    <PostDesc>
                                        <% if (post.image_url != '') { %>
                                            <!-- Show only image content -->
                                            <img src="<%= post.image_url %>">
                                        <% } else if (post.text_content != '') { %>
                                            <!-- Show only text content -->
                                            <p><%= post.text_content %></p>
                                        <% } %>
                                    </PostDesc>
                                </a>
                            </div>
                            <div class="action-container">
                              <% if(status === "active") { %>
                                <img src="/images/post_elements/comment.png" class="action-icon">
                                <a href="/posts/<%=post._id%>">&nbsp;Comment</a>
                              <% } %>
                                &nbsp;&nbsp;
                                <div id="copyLink:<%=post._id%>" class="copyLink">
                                    <img src="/images/post_elements/share.png" class="action-icon">
                                    Share
                                </div>
                                &nbsp;&nbsp;
                                <% if(post.author == user && status === "active"){ %>
                                    <img src="/images/post_elements/output-onlinepngtools.png" class="action-icon">
                                    &nbsp;
                                    <a href="/editPost/<%=post._id%>">Edit</a>
                                <%  } %>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>

            <div id="user-stats">
                <div id="nameDesc-row">
                    <div id="name">u/<%=username%></div>
                </div>
                <div class="horizontalLine gray"></div>
                <div id="number-row">
                    <div class="stat-container">
                        posts <br> <%= data.length %><br> 
                    </div>

                    <div class="verticalLine gray"></div>

                    <div class="stat-container">
                        comments <br> <%= commentD.length %>
                    </div>
                </div>
            </div>
        </div>
    </div>

<!-- Overlay + Modal -->
<div id="modalOverlay" class="modal-overlay" aria-hidden="true"></div>

<div id="modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle" aria-describedby="modalBody">
  <div class="modal-header">
    <h3 id="modalTitle">Title</h3>
    <button type="button" class="modal-close" aria-label="Close">&times;</button>
  </div>
  <div class="modal-body" id="modalBody">Body text…</div>
  <div class="modal-actions">
    <button type="button" id="modalOk">OK</button>
  </div>
</div>

<script>
$(function () {

  const $settingsIcon  = $(".settings-icon");
  const $settingsPopup = $("#settingsPopup");

  const $muteUser = $("#mute-user");
  const $banUser  = $("#ban-user");

  const $overlay = $('#modalOverlay');
  const $modal   = $('#modal');
  const $title   = $('#modalTitle');
  const $body    = $('#modalBody');

  $settingsIcon.on("click", function (e) {
    e.stopPropagation();
    $settingsPopup.toggle(); // show/hide
  });

  // Keep popup open when clicking inside it
  $settingsPopup.on("click", function (e) {
    e.stopPropagation();
  });

    // Close popup when clicking outside
  $(document).on("click", function () {
    $settingsPopup.hide();
  });

  function openModal(title, body) {
    $title.text(title);
    $body.html(body);
    $overlay.addClass('show');
    $modal.addClass('show');
    // Basic focus handling
    $('#modalOk').focus();
  }

  function closeModal() {
    $overlay.removeClass('show');
    $modal.removeClass('show');
  }

  // Open: Mute
  $('#mute-user').on('click', function (e) {
    e.preventDefault();
    $.ajax({
      url: '/profiles/<%= encodeURIComponent(username) %>/status',
      method: 'PUT',
      contentType: 'application/json',
      data: JSON.stringify({ status: 'muted' }),
      success: function (resp) {
        if (resp.ok) {
          openModal('User has been Muted', '<%=username%> is now unable to post and comment.');
        } else {
          alert(resp.error || 'Failed to mute user');
        }
      },
      error: function (xhr) {
        const msg = (xhr.responseJSON && xhr.responseJSON.error) || 'Request failed';
        alert(msg);
      }
    });
  });

  // Open: Ban
  $('#ban-user').on('click', function (e) {
    e.preventDefault();
     $.ajax({
      url: '/profiles/<%= encodeURIComponent(username) %>/status',
      method: 'PUT',
      contentType: 'application/json',
      data: JSON.stringify({ status: 'banned' }),
      success: function (resp) {
        if (resp.ok) {
          openModal('User has been Banned', '<%=username%> can no longer access the site.');
        } else {
          alert(resp.error || 'Failed to mute user');
        }
      },
      error: function (xhr) {
        const msg = (xhr.responseJSON && xhr.responseJSON.error) || 'Request failed';
        alert(msg);
      }
    });
  });

  // Close handlers
  $('#modalOk, .modal-close, #modalOverlay').on('click', closeModal);
  $(document).on('keydown', function (e) {
    if (e.key === 'Escape') closeModal();
  });

});
</script>
 
</body>